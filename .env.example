# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=123456:replace-me
ADMIN_IDS=111111111,222222222
DATABASE_URL=postgresql+asyncpg://romantika:romantika@127.0.0.1:5432/romantika
# MEDIA_DIR is REQUIRED (no default): where participant media is stored. This file is the only
# place the run targets read it from locally; in deployment point it at a volume, e.g.
# /var/lib/romantika/media.
MEDIA_DIR=./data/media
PUBLIC_BASE_URL=http://127.0.0.1:8010
ADMIN_CHAT_ID=
LOG_LEVEL=INFO
ENV=dev
# Dev-only Mini App auth bypass (ignored unless ENV=dev)
DEV_AUTH_USER_ID=
# Tests: point at a SCRATCH Postgres 16 to skip testcontainers.
# The suite drops the whole schema, so the database name must end in _test (or be empty).
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/romantika_test
